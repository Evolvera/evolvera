{
  "$schema_note": "Generic bootstrap template. Copy into the authorized test-only harness root and replace every <placeholder> before runtime execution. Unless explicitly absolute, paths resolve from PROJECT_ROOT. Existing project-native manifests may keep their own schema.",
  "manifest_version": 1,
  "path_base": "PROJECT_ROOT",
  "harness_root": "qa/app-validator",
  "documentation": {
    "readme": "qa/app-validator/README.md",
    "quickstart_heading": "Agent Quickstart",
    "commands_run_from": "PROJECT_ROOT"
  },
  "entrypoint": "qa/app-validator/bin/app-validator.mjs",
  "preflight": {
    "command": "node qa/app-validator/bin/app-validator.mjs doctor",
    "required_output": "APP_VALIDATOR_PREFLIGHT=PASS"
  },
  "commands": {
    "help": "node qa/app-validator/bin/app-validator.mjs help",
    "doctor": "node qa/app-validator/bin/app-validator.mjs doctor",
    "list_journeys": "node qa/app-validator/bin/app-validator.mjs list",
    "coverage": "node qa/app-validator/bin/app-validator.mjs coverage",
    "run_journey": "node qa/app-validator/bin/app-validator.mjs run {journey} --run-id {run_id}",
    "run_smoke": "node qa/app-validator/bin/app-validator.mjs smoke --run-id {run_id}",
    "run_full": "node qa/app-validator/bin/app-validator.mjs full --run-id {run_id}",
    "evidence": "node qa/app-validator/bin/app-validator.mjs evidence --run-id {run_id}",
    "teardown": "node qa/app-validator/bin/app-validator.mjs teardown --run-id {run_id}"
  },
  "platforms": {
    "<android|ios|desktop>": {
      "app_target": "<package-id, bundle-id, executable, or launch target>",
      "device_selector_env": "<environment-variable-name>",
      "runner": "<repo-relative runner path or existing framework command>",
      "ui_oracle": "<accessibility, UIAutomator, XCTest, or platform-state primitive>"
    }
  },
  "execution": {
    "real_device_execution_required": true,
    "static_or_dry_run_is_not_pass": true,
    "artifact_identity_must_match_target": true,
    "host_device_tool_architecture": "<required architecture/ABI compatibility statement>",
    "tool_provenance": {
      "pinned_version": "<tool-version or not-applicable>",
      "digest": "<recorded digest or not-applicable>",
      "reverify_signature_after_copy_or_install": "<true when the platform requires signature/trust verification, otherwise not-applicable>"
    },
    "runtime_scratch": {
      "durable_sources_cache_evidence": "<run-owned durable path or not-applicable>",
      "ephemeral_runtime_path": "<reconstructible local scratch path or not-applicable>",
      "rebuild_source_or_command": "<pinned source/documented command or not-applicable>",
      "filesystem_semantics_required": "<locking/permissions/case/symlink/exec requirements>"
    },
    "clock_or_process_mutation": {
      "used": false,
      "restore_in_finally": true
    },
    "long_lived_services": [
      {
        "name": "<service, emulator, VM, or tunnel>",
        "owner": "<orchestrator|harness-run>",
        "required_root_or_mount": "<path whose disappearance invalidates this service, or not-applicable>",
        "health_check": "<documented command/endpoint proving it still serves>",
        "self_terminate_when_root_or_health_lost": true,
        "max_lifetime": "<bounded lifetime or run-scoped>",
        "graceful_stop": "<documented stop command>"
      }
    ],
    "orphaned_process_forbidden": true
  },
  "actors": [
    {
      "id": "<actor-id>",
      "device_selector_env": "<environment-variable-name>",
      "identity_source": "<sanitized device/process identity field>",
      "distinct_device_group": "<group-name>",
      "liveness_check": "<documented command or oracle proving this actor is live>",
      "evidence_subpath": "<per-actor evidence subpath>",
      "teardown": "<graceful run-owned teardown or not-applicable>"
    }
  ],
  "actor_constraints": {
    "distinct_device_per_actor_group_required": "<true only for groups whose acceptance requires distinct devices; otherwise false>",
    "duplicate_device_identifiers_forbidden_when_distinct_required": true,
    "simultaneous_liveness_required": "<true when the user story requires concurrent actors; otherwise false>",
    "routing_consistency_check": "<documented check that traffic reached the intended actor, or not-applicable>"
  },
  "coverage": {
    "map": "qa/app-validator/COVERAGE.md",
    "statuses": ["COVERED", "PARTIAL", "GAP", "PROVIDER_BOUND"],
    "whole_app_claim_requires_no_material_gaps": true
  },
  "journeys": {
    "root": "qa/app-validator/journeys",
    "schema": "qa/app-validator/journeys/schema.json",
    "fixtures_root": "qa/app-validator/fixtures",
    "smoke_suite": "qa/app-validator/journeys/smoke",
    "inventory_source": "discovered-journeys",
    "hardcoded_counts_forbidden": true
  },
  "resources": [
    {
      "kind": "<emulator|simulator|database|filesystem|service|cache|other>",
      "identity_source": "<sanitized manifest field or environment-variable-name>",
      "ownership_proof": "<how this run proves DISPOSABLE_VERIFIED or NO_STATEFUL_RESOURCES>",
      "created_by": "<command and run_id relationship>",
      "fallback_forbidden": true,
      "teardown": "<run-owned teardown command or not-applicable>"
    }
  ],
  "network": {
    "policy": "<deny|explicit-allowlist>",
    "allowed_hosts": [],
    "fallback_route_forbidden": true
  },
  "credentials": {
    "source": "APP_VALIDATOR_CREDENTIALS_FILE",
    "file_permissions": "0600",
    "parent_directory_permissions": "0700",
    "secret_input_primitive": "<harness primitive that never logs or screenshots secrets, or not-required>",
    "secret_input_must_trigger_app_change_semantics": true,
    "secret_input_acceptance_oracle": "<observable app state proving acceptance without revealing the secret, or not-required>"
  },
  "oracles": {
    "ui": ["<machine-readable UI/platform oracle>"],
    "non_ui": ["<API, DB, log, filesystem, or platform-state oracle when authorized>"]
  },
  "evidence": {
    "root_env": "APP_VALIDATOR_EVIDENCE_ROOT",
    "run_path": "$APP_VALIDATOR_EVIDENCE_ROOT/{run_id}",
    "directory_permissions": "0700",
    "file_permissions": "0600",
    "permissions_recursive_at_creation": true,
    "artifacts": ["ui-tree", "screenshots", "logs", "result.json", "validation-report"],
    "authoritative_result": {
      "path": "$APP_VALIDATOR_EVIDENCE_ROOT/{run_id}/result.json",
      "note": "Canonical fallback authority. An existing project-native equivalent may be declared here instead; do not rename an existing one.",
      "report_must_match_authoritative_result": true
    }
  },
  "maintenance": {
    "authoritative_harness": true,
    "classifications": ["HARNESS_DRIFT", "APP_REGRESSION", "CONTRACT_CHANGE"],
    "readme_must_match_manifest": true,
    "cold_use_check_required": true,
    "cold_use_forbids_undeclared_prepared_state_or_irreplaceable_scratch": true,
    "harness_repair_requires_new_target_head_and_fresh_validator": true
  },
  "findings": {
    "root": "qa/app-validator/findings",
    "pitfalls": "qa/app-validator/PITFALLS.md"
  },
  "validation_report": "$APP_VALIDATOR_EVIDENCE_ROOT/{run_id}/VALIDATION_{head8}.md"
}
