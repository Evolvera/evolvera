{
  "$schema_note": "Generic bootstrap template. Copy into the authorized test-only harness root and replace every <placeholder> before runtime execution. Unless explicitly absolute, paths resolve from PROJECT_ROOT. Existing project-native manifests may keep their own schema.",
  "manifest_version": 1,
  "path_base": "PROJECT_ROOT",
  "harness_root": "qa/app-validator",
  "documentation": {
    "readme": "qa/app-validator/README.md",
    "quickstart_heading": "Agent Quickstart",
    "commands_run_from": "PROJECT_ROOT"
  },
  "entrypoint": "qa/app-validator/bin/app-validator.mjs",
  "preflight": {
    "command": "node qa/app-validator/bin/app-validator.mjs doctor",
    "required_output": "APP_VALIDATOR_PREFLIGHT=PASS"
  },
  "commands": {
    "help": "node qa/app-validator/bin/app-validator.mjs help",
    "doctor": "node qa/app-validator/bin/app-validator.mjs doctor",
    "list_journeys": "node qa/app-validator/bin/app-validator.mjs list",
    "coverage": "node qa/app-validator/bin/app-validator.mjs coverage",
    "run_journey": "node qa/app-validator/bin/app-validator.mjs run {journey} --run-id {run_id}",
    "run_smoke": "node qa/app-validator/bin/app-validator.mjs smoke --run-id {run_id}",
    "run_full": "node qa/app-validator/bin/app-validator.mjs full --run-id {run_id}",
    "evidence": "node qa/app-validator/bin/app-validator.mjs evidence --run-id {run_id}",
    "teardown": "node qa/app-validator/bin/app-validator.mjs teardown --run-id {run_id}"
  },
  "platforms": {
    "<android|ios|desktop>": {
      "app_target": "<package-id, bundle-id, executable, or launch target>",
      "device_selector_env": "<environment-variable-name>",
      "runner": "<repo-relative runner path or existing framework command>",
      "ui_oracle": "<accessibility, UIAutomator, XCTest, or platform-state primitive>"
    }
  },
  "coverage": {
    "map": "qa/app-validator/COVERAGE.md",
    "statuses": ["COVERED", "PARTIAL", "GAP", "PROVIDER_BOUND"],
    "whole_app_claim_requires_no_material_gaps": true
  },
  "journeys": {
    "root": "qa/app-validator/journeys",
    "schema": "qa/app-validator/journeys/schema.json",
    "fixtures_root": "qa/app-validator/fixtures",
    "smoke_suite": "qa/app-validator/journeys/smoke"
  },
  "resources": [
    {
      "kind": "<emulator|simulator|database|filesystem|service|cache|other>",
      "identity_source": "<sanitized manifest field or environment-variable-name>",
      "ownership_proof": "<how this run proves DISPOSABLE_VERIFIED or NO_STATEFUL_RESOURCES>",
      "created_by": "<command and run_id relationship>",
      "fallback_forbidden": true,
      "teardown": "<run-owned teardown command or not-applicable>"
    }
  ],
  "network": {
    "policy": "<deny|explicit-allowlist>",
    "allowed_hosts": []
  },
  "credentials": {
    "source": "APP_VALIDATOR_CREDENTIALS_FILE",
    "secret_input_primitive": "<harness primitive that never logs or screenshots secrets, or not-required>"
  },
  "oracles": {
    "ui": ["<machine-readable UI/platform oracle>"],
    "non_ui": ["<API, DB, log, filesystem, or platform-state oracle when authorized>"]
  },
  "evidence": {
    "root_env": "APP_VALIDATOR_EVIDENCE_ROOT",
    "run_path": "$APP_VALIDATOR_EVIDENCE_ROOT/{run_id}",
    "directory_permissions": "0700",
    "file_permissions": "0600",
    "artifacts": ["ui-tree", "screenshots", "logs", "runner-result", "validation-report"]
  },
  "maintenance": {
    "authoritative_harness": true,
    "classifications": ["HARNESS_DRIFT", "APP_REGRESSION", "CONTRACT_CHANGE"],
    "readme_must_match_manifest": true,
    "cold_use_check_required": true
  },
  "findings": {
    "root": "qa/app-validator/findings",
    "pitfalls": "qa/app-validator/PITFALLS.md"
  },
  "validation_report": "$APP_VALIDATOR_EVIDENCE_ROOT/{run_id}/VALIDATION_{head8}.md"
}
