{
  "mcpServers": {
"memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "lifecycle": "keep-alive"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "lifecycle": "lazy"
    },
    
    "zai-mcp": {
      "command": "npx",
      "args": ["-y", "@z_ai/mcp-server"],
      "env": {
        "Z_AI_API_KEY": "REDACTED_Z_AI_API_KEY",
        "Z_AI_MODE": "ZAI"
      },
      "lifecycle": "lazy"
    }
  }
}
