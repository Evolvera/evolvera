+
+// Session cwds are normalized once per refresh (not once per project): backslashes, case and a trailing slash still
+// match the environment, sessions without a cwd or of other projects stay out, and with many projects the refresh
+// stays linear (90 projects x 800 sessions used to cost ~100 ms of regex work per 2 s poll).
+test("tree matches session cwds by normalized path across many projects", async () => {
+  const projects = Array.from({ length: 90 }, (_, i) => ({ id: `p${i}`, name: `p${i}`, cwd: `C:/work/p${i}` }));
+  const sessions = Array.from({ length: 800 }, (_, i) => ({ path: `C:/s/${i}.jsonl`, header: { id: String(i), cwd: i % 3 === 0 ? `c:\\WORK\\p${i % 90}\\` : i % 3 === 1 ? `C:/work/p${i % 90}` : undefined }, stat: { mtimeMs: i, size: 0 }, title: `T${i}`, state: "pronto" }));
+  const service = createTreeService({ getProjects: async () => projects, getOrca: async () => ({ available: false }), getSessions: async () => sessions, getLive: async () => [] });
+  const started = performance.now();
+  const tree = await service.get();
+  const elapsed = performance.now() - started;
+  const p0 = tree.projects.find((project) => project.id === "p0");
+  // p0 gets sessions 0, 90, 180, ... whose index % 3 is 0 or 1 (the third kind has no cwd).
+  const expected = sessions.filter((s, i) => i % 90 === 0 && i % 3 !== 2).length;
+  assert.equal(p0.envs.length, 1);
+  assert.equal(p0.envs[0].pis.length + p0.envs[0].morePis, expected);
+  assert.ok(elapsed < 1000, `refresh took ${Math.round(elapsed)} ms`);
