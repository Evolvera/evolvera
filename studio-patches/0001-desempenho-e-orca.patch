+    assert.deepEqual(lib.orcaWorktreeSetArgs({ worktreeId: "r::C:/w", workspaceStatus: "in-review" }), ["worktree", "set", "--worktree=id:r::C:/w", "--workspace-status=in-review", "--json"]);
