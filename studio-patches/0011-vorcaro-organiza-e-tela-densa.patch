+.vc-change i { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); }
+.vc-change[data-to="aguardando"] i { background: var(--amber); }
+.vc-change[data-to="feito"] i { background: var(--green); }
+.vc-change[data-to="fazendo"] i { background: var(--sage); }
+.vc-change-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.vc-change-what { color: var(--muted); font-size: 12px; white-space: nowrap; }
+
+/* ---- Vorcaro's picture (only when pi-studio-data/vorcaro-foto.* exists): a round crop on the face */
+.vc-avatar { display: none; }
+html[data-vc-photo] .vc-avatar, html[data-vc-photo] .nav-vorcaro .nav-ico, html[data-vc-photo] .vc-btn::before {
+  background: var(--vc-photo) 50.5% 21% / auto 260% no-repeat; border-radius: 50%; box-shadow: 0 0 0 1.5px var(--bg-main), 0 0 0 3px color-mix(in srgb, var(--sage) 55%, transparent);
+}
+html[data-vc-photo] .vc-avatar { display: block; flex: none; width: 38px; height: 38px; }
+html[data-vc-photo] .nav-vorcaro .nav-ico { width: 30px; height: 30px; }
+html[data-vc-photo] .nav-vorcaro .nav-ico svg, html[data-vc-photo] .vc-btn > svg { display: none; }
+html[data-vc-photo] .vc-btn::before { content: ""; flex: none; width: 20px; height: 20px; }
+
+/* ---- Vorcaro: where a request is mirrored (Orca, GitHub) */
