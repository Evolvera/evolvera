+button.user:focus-visible { outline: 2px solid var(--sage); outline-offset: 1px; }
+
+/* ---- Vorcaro: organization by project (open sessions against the limit) */
+.vc-org { display: grid; gap: 6px; }
+.vc-org-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 8px; font-size: 13px; }
+.vc-org-name { overflow: hidden; color: var(--text-2); text-overflow: ellipsis; white-space: nowrap; }
+.vc-org-row.is-over .vc-org-name { color: var(--amber); font-weight: 600; }
+.vc-org-slots { display: inline-flex; gap: 3px; }
+.vc-org-slots i { width: 12px; height: 8px; border-radius: 2px; background: var(--bg-active); }
+.vc-org-slots i[data-state="main"] { background: var(--sage); }
+.vc-org-slots i[data-state="over"] { background: var(--amber); }
