+.claude-item time { color: var(--faint); font-size: 12px; }
+.claude-item i { width: 6px; height: 6px; border-radius: 50%; background: var(--faint); }
+.claude-item i[data-dot="wait"] { background: var(--amber); }
+.claude-item i[data-dot="work"] { background: var(--sage); }
+.claude-item i[data-dot="open"] { background: transparent; border: 1.5px solid var(--faint); }
+.claude-item i[data-dot="done"] { background: var(--green); opacity: .7; }
+
+/* "Vorcaro, a inteligência Master": the comma belongs to the name, the tagline follows with a space */
+#vorcaroTitle .vc-sub { margin-left: 5px; }
