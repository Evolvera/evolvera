+
+/* ================================================================ palco dos agentes, workbench e temas
+   Technical, calm and human: true black or warm white, one forest-green accent, status colours only for state,
+   Plus Jakarta Sans for words and Geist Mono for telemetry (both served from /fonts, OFL). Motion only answers
+   something that happened (a node arrives, a state changes, work passes along a wire) and never loops. */
+@font-face {
+  font-family: "Plus Jakarta Sans";
+  src: url("/fonts/plus-jakarta-sans-latin.woff2") format("woff2");
+  font-weight: 200 800;
+  font-style: normal;
+  font-display: swap;
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
+}
+@font-face {
+  font-family: "Plus Jakarta Sans";
+  src: url("/fonts/plus-jakarta-sans-latin-ext.woff2") format("woff2");
+  font-weight: 200 800;
+  font-style: normal;
+  font-display: swap;
+  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
+}
+@font-face {
+  font-family: "Geist Mono";
+  src: url("/fonts/geist-mono.woff2") format("woff2");
+  font-weight: 100 900;
+  font-style: normal;
+  font-display: swap;
+}
+
+:root {
+  --accent-btn: #7cc4a0;
+  --accent-hover: #8fd1b0;
+  --on-accent: #07130d;
+  --line-3: #3a3a40;
+  --focus-line: #4a4a52;
+  --scroll: #2e2e33;
+  --scroll-hover: #4a4a52;
+  --switch-knob: #f2f2f3;
+  --backdrop: #000000a6;
+  --err-bg: #ec8d7d14;
+  --err-line: #ec8d7d40;
+  --warn-bg: #e3bd6b14;
+  --warn-line: #e3bd6b40;
+  --warn-text: #ecd9a0;
+  --diff-add-bg: #7cc4a01a;
+  --diff-add: #a9e6c0;
+  --diff-del-bg: #ec8d7d1a;
+  --diff-del: #f0bcb8;
+  --shadow-card: 0 1px 2px #00000052, 0 10px 28px -16px #0000008f;
+  --shadow-card-hover: 0 1px 2px #00000066, 0 16px 34px -18px #000000b3;
+  --shadow-xl: 0 24px 64px #000000b8, 0 2px 8px #00000080;
+  --stage-bg: #0e0e10;
+  --wire: #2e2e33;
+  /* "--c-blue" names the working state in the upstream stylesheet; VeroNati has no blue, so it carries the accent. */
+  --c-blue: #7cc4a0;
+  --c-blue-soft: #7cc4a01f;
+  --c-purple: #a5a5ad;
+  --c-purple-soft: #a5a5ad1f;
+  --c-teal: #7cc4a0;
+  --c-teal-soft: #7cc4a01f;
+  --tone-work: #7cc4a0;
+  --tone-wait: #e3bd6b;
+  --tone-ok: #7cc4a0;
+  --tone-bad: #ec8d7d;
+  --tone-idle: #83838c;
+}
+
+/* Light: warm white base, graphite text, forest green accent with white text on it. The terminal stays a dark pane. */
+@media (prefers-color-scheme: light) {
+  :root:not([data-theme="dark"]) {
+    color-scheme: light;
+    --bg: #f8f8f7; --bg-side: #f3f3f1; --bg-main: #fcfcfb; --bg-card: #ffffff; --bg-raise: #ffffff; --bg-hover: #f1f1ef; --bg-active: #e9e9e6; --bg-input: #ffffff; --bg-code: #f4f4f2;
+    --line: #e8e8e5; --line-2: #dcdcd8; --line-3: #c9c9c4; --focus-line: #b4b4ae;
+    --text: #26292c; --text-2: #3b3f43; --muted: #5b6166; --faint: #83888d;
+    --accent: #26292c; --accent-2: #5b6166; --accent-soft: #ececea; --blue: #3b3f43; --blue-soft: #ececea;
+    --link: #1f6f5c; --green: #2f7a58; --red: #b0503f; --amber: #94680f; --sage: #1f6f5c; --sage-soft: #1f6f5c14;
+    --c-green: #2f7a58; --c-amber: #94680f; --c-red: #b0503f; --c-blue: #1f6f5c; --c-purple: #5b6166; --c-teal: #1f6f5c;
+    --c-green-soft: #2f7a5814; --c-amber-soft: #94680f14; --c-red-soft: #b0503f14; --c-blue-soft: #1f6f5c14; --c-purple-soft: #5b616614; --c-teal-soft: #1f6f5c14;
+    --accent-btn: #1f6f5c; --accent-hover: #25806a; --on-accent: #ffffff;
+    --scroll: #d6d6d2; --scroll-hover: #b9b9b4; --switch-knob: #ffffff; --backdrop: #26292c59;
+    --err-bg: #b0503f0f; --err-line: #b0503f40; --warn-bg: #94680f0f; --warn-line: #94680f40; --warn-text: #6f4e0b;
+    --diff-add-bg: #2f7a5814; --diff-add: #1f5c40; --diff-del-bg: #b0503f12; --diff-del: #8f3b2d;
+    --shadow: 0 1px 2px #26292c0d, 0 14px 36px -18px #26292c38; --shadow-s: 0 1px 2px #26292c0d, 0 8px 22px -14px #26292c2e;
+    --shadow-card: 0 1px 2px #26292c0f, 0 10px 28px -16px #26292c29; --shadow-card-hover: 0 1px 2px #26292c14, 0 16px 34px -18px #26292c3d;
+    --shadow-xl: 0 24px 64px -12px #26292c40, 0 2px 8px #26292c14;
+    --stage-bg: #ffffff; --wire: #d6d6d2;
+    --tone-work: #1f6f5c; --tone-wait: #94680f; --tone-ok: #2f7a58; --tone-bad: #b0503f; --tone-idle: #83888d;
+  }
+}
+:root[data-theme="light"] {
+  color-scheme: light;
+  --bg: #f8f8f7; --bg-side: #f3f3f1; --bg-main: #fcfcfb; --bg-card: #ffffff; --bg-raise: #ffffff; --bg-hover: #f1f1ef; --bg-active: #e9e9e6; --bg-input: #ffffff; --bg-code: #f4f4f2;
+  --line: #e8e8e5; --line-2: #dcdcd8; --line-3: #c9c9c4; --focus-line: #b4b4ae;
+  --text: #26292c; --text-2: #3b3f43; --muted: #5b6166; --faint: #83888d;
+  --accent: #26292c; --accent-2: #5b6166; --accent-soft: #ececea; --blue: #3b3f43; --blue-soft: #ececea;
+  --link: #1f6f5c; --green: #2f7a58; --red: #b0503f; --amber: #94680f; --sage: #1f6f5c; --sage-soft: #1f6f5c14;
+  --c-green: #2f7a58; --c-amber: #94680f; --c-red: #b0503f; --c-blue: #1f6f5c; --c-purple: #5b6166; --c-teal: #1f6f5c;
+  --c-green-soft: #2f7a5814; --c-amber-soft: #94680f14; --c-red-soft: #b0503f14; --c-blue-soft: #1f6f5c14; --c-purple-soft: #5b616614; --c-teal-soft: #1f6f5c14;
+  --accent-btn: #1f6f5c; --accent-hover: #25806a; --on-accent: #ffffff;
+  --scroll: #d6d6d2; --scroll-hover: #b9b9b4; --switch-knob: #ffffff; --backdrop: #26292c59;
+  --err-bg: #b0503f0f; --err-line: #b0503f40; --warn-bg: #94680f0f; --warn-line: #94680f40; --warn-text: #6f4e0b;
+  --diff-add-bg: #2f7a5814; --diff-add: #1f5c40; --diff-del-bg: #b0503f12; --diff-del: #8f3b2d;
+  --shadow: 0 1px 2px #26292c0d, 0 14px 36px -18px #26292c38; --shadow-s: 0 1px 2px #26292c0d, 0 8px 22px -14px #26292c2e;
+  --shadow-card: 0 1px 2px #26292c0f, 0 10px 28px -16px #26292c29; --shadow-card-hover: 0 1px 2px #26292c14, 0 16px 34px -18px #26292c3d;
+  --shadow-xl: 0 24px 64px -12px #26292c40, 0 2px 8px #26292c14;
+  --stage-bg: #ffffff; --wire: #d6d6d2;
+  --tone-work: #1f6f5c; --tone-wait: #94680f; --tone-ok: #2f7a58; --tone-bad: #b0503f; --tone-idle: #83888d;
+}
+:root[data-theme="dark"] { color-scheme: dark; }
+
+body { font-feature-settings: "ss01" on; }
+.topbar { border-bottom: 1px solid var(--line); }
+.brand-name, .title-btn { font-weight: 700; letter-spacing: -0.01em; }
+
+/* --- theme switch (sun, moon, monitor) */
+.theme-switch { display: inline-flex; align-items: center; gap: 2px; height: 30px; padding: 2px; margin-right: 6px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-side); }
+.theme-switch button { display: inline-grid; place-items: center; width: 26px; height: 24px; border-radius: 999px; color: var(--faint); transition: background-color 180ms var(--ease-vero), color 180ms var(--ease-vero); }
+.theme-switch button svg { width: 15px; height: 15px; }
+.theme-switch button:hover { color: var(--text); }
+.theme-switch button[aria-checked="true"] { background: var(--bg-card); color: var(--text); box-shadow: var(--shadow-card); }
+
+/* --- the stage above the chat */
+.thread { padding-top: 28px; }
+.stage {
+  flex: none;
+  position: relative;
+  margin: 14px 18px 0;
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  background: var(--stage-bg);
+  box-shadow: var(--shadow-card);
+  overflow: hidden;
+}
+.stage-head { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 8px 0 14px; }
+.stage[data-open="true"] .stage-head { border-bottom: 1px solid var(--line); }
+.stage-title { display: inline-flex; align-items: center; gap: 8px; margin: 0; color: var(--text); font: 700 14px/1 var(--font); letter-spacing: -0.01em; white-space: nowrap; }
+.stage-title svg { width: 16px; height: 16px; color: var(--sage); }
+.stage-summary { flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 6px; min-width: 0; overflow: hidden; }
+.st-chip { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font: 500 12px/1 var(--font); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.st-chip b { color: var(--text); font-weight: 700; }
+.st-chip i { width: 6px; height: 6px; border-radius: 1.5px; background: var(--tone-idle); }
+.st-chip[data-tone="work"] i { background: var(--tone-work); }
+.st-chip[data-tone="wait"] { border-color: color-mix(in srgb, var(--tone-wait) 40%, transparent); }
+.st-chip[data-tone="wait"] i { background: transparent; border: 1.5px solid var(--tone-wait); border-radius: 50%; width: 8px; height: 8px; }
+.st-cost { flex: none; display: inline-flex; align-items: center; gap: 8px; height: 24px; padding: 0 9px; border: 1px solid var(--line); border-radius: 999px; font: 12px/1 var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
+.st-cost b { color: var(--text); font-weight: 600; }
+.st-cost-bar { display: flex; gap: 1px; width: 56px; height: 6px; border-radius: 3px; overflow: hidden; background: var(--bg-active); }
+.st-cost-bar i { display: block; height: 100%; background: var(--sage); }
+.st-cost-bar i:nth-child(2n) { opacity: 0.62; }
+.st-cost-bar i:nth-child(3n) { opacity: 0.4; }
+.stage-toggle svg { transition: transform 260ms var(--ease-vero); }
+.stage[data-open="false"] .stage-toggle svg { transform: rotate(-90deg); }
+
+.stage-body { display: grid; grid-template-columns: minmax(0, 1fr); max-height: min(54vh, 460px); overflow: auto; }
+.stage-canvas { position: relative; min-width: 0; padding: 16px 16px 18px; }
+.stage-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
+.stage-tiers { position: relative; display: flex; flex-direction: column; align-items: center; gap: 34px; }
+.stage-tier { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; width: 100%; }
+
+.wire { fill: none; stroke: var(--wire); stroke-width: 1.25; transition: stroke 400ms var(--ease-vero); }
+.wire[data-tone="work"] { stroke: var(--tone-work); stroke-opacity: 0.75; }
+.wire[data-tone="wait"] { stroke: var(--tone-wait); stroke-dasharray: 4 4; }
+.wire[data-tone="ok"] { stroke: var(--line-3); }
+.wire[data-tone="bad"] { stroke: var(--tone-bad); stroke-opacity: 0.6; }
+.wire[data-tone="idle"] { stroke-dasharray: 2 4; }
+.wire-end { fill: var(--stage-bg); stroke: var(--wire); stroke-width: 1.25; }
+.wire-end[data-tone="work"] { stroke: var(--tone-work); fill: var(--tone-work); }
+.wire-end[data-tone="wait"] { stroke: var(--tone-wait); }
+.wire-pulse { fill: none; stroke: var(--tone-work); stroke-width: 2.5; stroke-linecap: round; }
+
+/* one node per agent */
+.ag-node {
+  --tone: var(--tone-idle);
+  position: relative;
+  display: grid;
+  align-content: start;
+  gap: 5px;
+  width: clamp(188px, calc((100% - 24px) / 3), 280px);
+  min-height: 0;
+  padding: 10px 12px 10px 14px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: var(--bg-card);
+  color: var(--text);
+  text-align: left;
+  box-shadow: var(--shadow-card);
+  transition: transform 260ms var(--ease-vero), box-shadow 260ms var(--ease-vero), border-color 260ms var(--ease-vero);
+}
+.ag-node:hover { transform: translateY(-2px); border-color: var(--line-2); box-shadow: var(--shadow-card-hover); }
+.ag-node:active { transform: scale(0.98); }
+.ag-node:focus-visible { outline-offset: 3px; border-radius: 12px; }
+.ag-node[data-tone="work"] { --tone: var(--tone-work); }
+.ag-node[data-tone="wait"] { --tone: var(--tone-wait); border-color: color-mix(in srgb, var(--tone-wait) 45%, var(--line)); }
+.ag-node[data-tone="ok"] { --tone: var(--tone-ok); }
+.ag-node[data-tone="bad"] { --tone: var(--tone-bad); }
+.ag-node.is-current { border-color: var(--sage); }
+.ag-rail { position: absolute; left: -1px; top: 12px; bottom: 12px; width: 3px; border-radius: 0 3px 3px 0; background: var(--tone); }
+.ag-node[data-tone="ok"] .ag-rail { opacity: 0.5; }
+.ag-node[data-tone="idle"] .ag-rail { opacity: 0.35; }
+.ag-top { display: flex; align-items: center; gap: 9px; min-width: 0; }
+.ag-glyph { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-hover); color: var(--text-2); font: 600 13px/1 var(--mono); }
+.ag-node[data-role="lead"] .ag-glyph { border-color: transparent; background: var(--text); color: var(--bg); font: 700 15px/1 var(--font); }
+.ag-id { display: grid; flex: 1; min-width: 0; line-height: 1.25; }
+.ag-name { overflow: hidden; color: var(--text); font-size: 13.5px; font-weight: 700; letter-spacing: -0.005em; text-overflow: ellipsis; white-space: nowrap; }
+.ag-kind { overflow: hidden; color: var(--faint); font: 12px/1.3 var(--mono); text-overflow: ellipsis; white-space: nowrap; }
+.ag-time { flex: none; margin-left: auto; color: var(--muted); font: 500 12px/1.2 var(--mono); font-variant-numeric: tabular-nums; }
+.ag-line { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.ag-state { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 999px; background: color-mix(in srgb, var(--tone) 13%, transparent); color: var(--tone); font: 600 12px/1 var(--font); white-space: nowrap; }
+.ag-state::before { content: ""; flex: none; width: 6px; height: 6px; border-radius: 1.5px; background: currentColor; }
+.ag-node[data-tone="wait"] .ag-state::before { width: 7px; height: 7px; border-radius: 50%; background: transparent; border: 1.5px solid currentColor; }
+.ag-node[data-tone="ok"] .ag-state::before { width: 7px; height: 4px; border-radius: 0; background: transparent; border: solid currentColor; border-width: 0 0 1.6px 1.6px; transform: translateY(-1.5px) rotate(-45deg); }
+.ag-node[data-tone="idle"] .ag-state { background: var(--bg-hover); color: var(--muted); }
+.ag-step, .ag-meta { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ag-step { color: var(--text-2); font: 12.5px/1.4 var(--mono); }
+.ag-step:empty { display: none; }
+.ag-meta { display: flex; color: var(--faint); font: 12px/1.4 var(--mono); font-variant-numeric: tabular-nums; }
+.ag-meta span { flex: none; }
+.ag-meta span:last-child { flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; }
+.ag-meta span + span::before { content: "·"; margin: 0 6px; }
+
+/* one agent: one calm node, centred */
+.stage[data-mode="solo"] .stage-canvas { padding: 12px 16px 14px; }
+.stage[data-mode="solo"] .ag-node { width: min(100%, 440px); }
+
+.ag-node.is-new { animation: ag-in 600ms var(--ease-vero) both; }
+.ag-node.state-changed .ag-state { animation: ag-state-in 520ms var(--ease-vero); }
+@keyframes ag-in { from { opacity: 0; transform: translateY(10px); } }
+@keyframes ag-state-in { from { opacity: 0; transform: translateY(-4px); } }
+
+/* team messages, newest first */
+.stage-mail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; min-width: 0; margin: 0; padding: 10px 12px 12px; border-top: 1px solid var(--line); list-style: none; }
+.mail-head { display: none; }
+.mail-item { display: grid; gap: 3px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-card); }
+.mail-item.is-new { animation: ag-in 600ms var(--ease-vero) both; }
+.mail-route { display: flex; align-items: center; gap: 6px; min-width: 0; color: var(--faint); font: 12px/1.3 var(--mono); }
+.mail-route b { min-width: 0; overflow: hidden; color: var(--text-2); font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
+.mail-route time { flex: none; }
+.mail-route time { margin-left: auto; font-variant-numeric: tabular-nums; }
+.mail-text { color: var(--text-2); font-size: 13px; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
+
+/* --- workbench (right panel): Terminal, Worktrees, Checklist, Contexto; the rest as icons on the right */
+.panel { background: var(--bg-side); }
+.insp-tabs { height: 44px; padding: 0 6px; gap: 0; }
+.insp-tab { padding: 0 6px; color: var(--muted); font-size: 12.5px; font-weight: 600; }
+.insp-tab::after { background: var(--sage); height: 2px; }
+.insp-tab:not(.is-minor) + .insp-tab.is-minor { margin-left: auto; }
+.insp-tab.is-minor { padding: 0 5px; gap: 3px; }
+.insp-tab.is-minor .insp-label { display: none; }
+/* Full width: the four main views read as words; the icons come back only when the tabs have to shrink. */
+.insp-tabs:not(.fit-icons):not(.fit-selected) .insp-tab:not(.is-minor) svg { display: none; }
+.insp-tab.is-minor .count-badge { min-width: 7px; width: 7px; height: 7px; padding: 0; border: 0; background: var(--sage); font-size: 0; }
+
+/* --- buttons and focus on the accent */
+:focus-visible { outline-color: var(--sage); }
+.btn-primary, .send-btn, .stop-btn { transition: background-color 180ms var(--ease-vero), transform 180ms var(--ease-vero); }
+.btn:active, .send-btn:active:not(:disabled), .ag-node:active { transform: scale(0.98); }
+
+/* --- a team member's conversation */
+.dialog-agent { width: min(760px, calc(100vw - 32px)); max-height: min(80dvh, 760px); padding: 0; }
+.dialog-agent[open] { display: flex; flex-direction: column; }
+.dialog-agent .ad-shell { min-height: 0; flex: 1; }
+.ad-shell { display: grid; grid-template-rows: auto minmax(0, 1fr); max-height: inherit; }
+.ad-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 18px; border-bottom: 1px solid var(--line); }
+.ad-head .ag-glyph { width: 32px; height: 32px; font-size: 14px; }
+.ad-id { flex: 1; min-width: 0; }
+.ad-id h3 { margin: 0; font-size: 16px; font-weight: 700; }
+.ad-meta { margin: 2px 0 0; color: var(--faint); font: 12px/1.4 var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ad-body { display: grid; align-content: start; gap: 12px; padding: 18px; overflow-y: auto; }
+.ad-body header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; color: var(--faint); font: 12px/1.3 var(--mono); }
+.ad-body header b { color: var(--text-2); font-weight: 600; }
+.ad-body header time { margin-left: auto; font-variant-numeric: tabular-nums; }
+.ad-out { padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-card); }
+.ad-out .md { font-size: 14px; }
+.ad-mail { padding: 10px 12px; border-left: 3px solid var(--line-3); border-radius: 0 10px 10px 0; background: var(--bg-hover); }
+.ad-mail[data-dir="out"] { border-left-color: var(--sage); }
+.ad-mail p { margin: 0; color: var(--text-2); font-size: 13.5px; line-height: 1.5; }
+.ad-empty { margin: 24px 0; color: var(--faint); font-size: 14px; text-align: center; }
+
+@media (max-height: 820px) {
+  .stage { margin-top: 10px; }
+  .stage-canvas { padding: 12px 14px 14px; }
+  .stage-tiers { gap: 26px; }
+  .ag-node { min-height: 0; padding: 8px 10px 8px 13px; gap: 4px; }
+  .stage-mail .mail-item:nth-child(n+4) { display: none; }
+  .thread { padding-top: 20px; }
+}
+@media (max-width: 860px) {
+  .stage { margin: 10px 10px 0; }
+  .stage-mail { grid-template-columns: minmax(0, 1fr); }
+  .stage-mail .mail-item:nth-child(n+3) { display: none; }
+  .ag-node { width: calc(50% - 6px); }
+  .stage-summary .st-cost { display: none; }
+  .theme-switch { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ag-node, .ag-node.is-new, .ag-node.state-changed .ag-state, .mail-item.is-new, .wire, .stage-toggle svg, .theme-switch button { animation: none !important; transition: none !important; }
+}
+:root[data-motion="reduce"] .ag-node, :root[data-motion="reduce"] .ag-node .ag-state, :root[data-motion="reduce"] .mail-item, :root[data-motion="reduce"] .wire { animation: none !important; transition: none !important; }
