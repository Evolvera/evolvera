+    assert.equal(contextGauge(null, defaults), null);
+    assert.match(contextGauge({ contextUsage: { tokens: 10, contextWindow: 100 } }, defaults, { lastCompactionAt: 0, now: 5 * MIN }).compacted, /compactado há 5 min/);
+  });
