+.vc-steps li[data-step="done"] { color: var(--text-2); }
+.vc-steps li[data-step="done"] i { border-color: var(--tone-ok); background: var(--tone-ok); }
+.vc-steps li[data-step="done"]::before, .vc-steps li[data-step="current"]::before, .vc-steps li[data-step="blocked"]::before { background: var(--tone-ok); }
+.vc-steps li[data-step="current"] { color: var(--text); font-weight: 600; }
+.vc-steps li[data-step="current"] i { border-color: var(--tone-work); box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone-work) 22%, transparent); }
+.vc-steps li[data-step="blocked"] { color: var(--tone-wait); font-weight: 600; }
+.vc-steps li[data-step="blocked"] i { border-color: var(--tone-wait); }
+.vc-act { display: grid; gap: 7px; }
+.vc-act-row { display: grid; grid-template-columns: minmax(80px, 34%) minmax(0, 1fr) auto; align-items: center; gap: 8px; font-size: 12.5px; }
+.vc-act-name { overflow: hidden; color: var(--text-2); text-overflow: ellipsis; white-space: nowrap; }
+.vc-act-bar { display: flex; gap: 1px; height: 8px; min-width: 6px; border-radius: 4px; overflow: hidden; }
+.vc-act-row b { font: 600 12px var(--mono); color: var(--muted); }
+
+/* the filter bar (same component wherever there is a board) */
+.filter-bar { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.fb-group { display: inline-flex; align-items: center; gap: 2px; height: 32px; padding: 2px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-side); }
+.fb-seg { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 11px; border-radius: 999px; color: var(--muted); font-size: 12.5px; font-weight: 600; white-space: nowrap; transition: background-color 180ms var(--ease-vero), color 180ms var(--ease-vero); }
+.fb-seg svg { width: 14px; height: 14px; }
+.fb-seg:hover { color: var(--text); }
+.fb-seg[aria-pressed="true"] { background: var(--bg-card); color: var(--text); box-shadow: var(--shadow-card); }
+.fb-range { position: absolute; z-index: 30; top: calc(100% + 6px); left: 0; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px; padding: 12px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--bg-card); box-shadow: var(--shadow-xl); }
+.fb-range label { display: grid; gap: 4px; color: var(--muted); font-size: 12px; font-weight: 600; }
+.fb-range input { height: 32px; padding: 0 8px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--bg-input); color: var(--text); color-scheme: inherit; }
+.fb-range .btn { height: 32px; padding: 0 12px; font-size: 13px; }
+.fb-select { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12.5px; font-weight: 600; }
+.fb-select select { height: 32px; padding: 0 28px 0 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-side); color: var(--text); font-size: 13px; }
+.fb-chips { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.fb-chip { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 6px 0 10px; border: 1px solid color-mix(in srgb, var(--sage) 45%, var(--line)); border-radius: 999px; background: var(--sage-soft); color: var(--text); font-size: 12.5px; font-weight: 600; }
+.fb-chip svg { width: 13px; height: 13px; color: var(--muted); }
+.fb-clear { color: var(--link); font-size: 12.5px; font-weight: 600; }
+.fb-clear:hover { text-decoration: underline; }
+
+@media (max-width: 1180px) {
+  .vc-view-body { grid-template-columns: auto minmax(0, 1fr); }
+  .vc-live { display: none; }
+  .vc-board-pane[data-open="true"] { width: min(560px, 56vw); }
+}
+@media (max-width: 860px) {
+  .vc-view-body { grid-template-columns: minmax(0, 1fr); }
+  .vc-board-pane { display: none; }
+  .vc-view-head .filter-bar { margin-left: 0; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .vc-board-pane, .vc-board-toggle svg, .fb-seg, .vc-exit { transition: none; }
+}
+
+/* --- density: a tighter scale for 1366x768 and 1440x900 (14px body, 15px chat, 12px labels; nothing under 12px) */
+body { font-size: 14px; line-height: 1.5; }
+html { --chat-scale: 0.88; }
+html[data-font="small"] { --chat-scale: 0.82; }
+html[data-font="large"] { --chat-scale: 1; }
+.thread { gap: 20px; padding-left: 32px; padding-right: 32px; }
+.composer textarea { font-size: 15px; }
+.nav-item, .session-item { font-size: 13.5px; }
+.dock { padding-bottom: 10px; }
+.composer { padding: 10px 12px 8px 18px; }
+
+/* --- HUD: what is happening now, time left, last turn (above the composer) */
+.hud-activity { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-bottom: 8px; padding: 7px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-card); color: var(--muted); font-size: 12.5px; box-shadow: var(--shadow-card); }
