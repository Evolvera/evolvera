+.hud-eta b { color: var(--text); font-weight: 700; }
+.hud-eta-bar { display: inline-block; width: 64px; height: 6px; border-radius: 3px; overflow: hidden; background: var(--bg-active); }
+.hud-eta-bar i { display: block; height: 100%; background: var(--sage); transition: width 600ms var(--ease-vero); }
+.hud-receipt { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; color: var(--muted); font-size: 12.5px; text-align: left; }
+.hud-receipt b { color: var(--text-2); font-weight: 600; }
+.hud-receipt:not(:disabled):hover b { color: var(--text); }
+.hud-link { color: var(--link); font-weight: 600; }
+
+/* --- status line: default model, the one in use, context with the auto-compaction mark, cost */
+.composer-meta { gap: 8px; font-size: 12.5px; }
+.hud-default { display: inline-flex; align-items: center; gap: 5px; min-width: 0; color: var(--faint); font-size: 12px; white-space: nowrap; }
+.hud-default b { overflow: hidden; color: var(--muted); font: 500 12px var(--mono); text-overflow: ellipsis; }
+.hud-default.is-different b { color: var(--amber); }
+.hud-inuse { margin-right: 5px; color: var(--faint); font-size: 12px; font-weight: 500; }
+.model-btn #modelName { font-family: var(--mono); font-size: 12.5px; }
+.model-btn.is-mismatch { box-shadow: inset 0 0 0 1px var(--warn-line); }
+.ctx-ring.is-replaced { display: none !important; }
+.hud-ctx { --tone: var(--tone-ok); display: inline-flex; align-items: center; gap: 7px; height: 26px; padding: 0 8px; border-radius: 8px; color: var(--text-2); font: 12px var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.hud-ctx:hover { background: var(--bg-hover); }
+.hud-ctx[data-tone="wait"] { --tone: var(--tone-wait); }
+.hud-ctx[data-tone="bad"] { --tone: var(--tone-bad); }
+.hud-ctx-bar { position: relative; display: inline-block; width: 92px; height: 6px; border-radius: 3px; background: var(--bg-active); }
+.hud-ctx-bar i { position: absolute; inset: 0 auto 0 0; border-radius: 3px; background: var(--tone); transition: width 600ms var(--ease-vero); }
+.hud-ctx-bar b { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; border-radius: 1px; background: var(--text-2); }
+.hud-ctx-note { color: var(--faint); font-family: var(--font); }
+@media (max-width: 1280px) { .hud-default span, .hud-ctx-note { display: none; } }
+@media (max-width: 860px) { .hud-default, .hud-eta span:not(.hud-eta-bar) { display: none; } }
+@media (prefers-reduced-motion: reduce) { .hud-eta-bar i, .hud-ctx-bar i { transition: none; } }
+
+/* one live indicator in the simple view (the HUD line); the mode label repeats the title in the top bar */
+.run-status.is-hud { display: none; }
+.composer-meta .mode-label { display: none; }
+.composer-meta .status-line { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hud-default { flex: none; }
+.composer-meta .model-btn { min-width: 0; flex: 0 1 auto; overflow: hidden; }
+.composer-meta .model-btn #modelName { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hud-ctx { flex: none; }
+.composer-meta .model-btn { flex: none; }
+.composer-meta .status-line { flex: 1 1 0; }
+@media (max-width: 1439px) {
+  .hud-default span { display: none; }
+  .hud-ctx-bar { width: 60px; }
+  .composer-meta { gap: 6px; }
+}
+
+/* the composer never leaves the screen: the stage shrinks and scrolls inside first */
+.stage { display: flex; flex-direction: column; flex: 0 1 auto; min-height: 44px; }
+.stage-head { flex: none; }
+.stage-body { flex: 0 1 auto; min-height: 0; }
+.dock { flex: none; }
+@media (max-height: 820px) {
+  .stage-body { max-height: 38vh; }
+  .todo-list { max-height: 104px; overflow-y: auto; }
+}
+@media (max-width: 1439px) {
+  .ag-node { width: clamp(172px, calc((100% - 24px) / 3), 260px); }
+  .st-cost-bar { display: none; }
+  .stage-summary { gap: 4px; }
+  .st-chip, .st-cost { padding: 0 7px; }
+}
